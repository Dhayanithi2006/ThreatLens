# =====================================================================
# ThreatLens Core Configuration
# =====================================================================
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
THREAT_INTEL_MODE=auto

# =====================================================================
# ThreatLens GraphOps - Neo4j Database Configuration
# =====================================================================
# Official Bolt URI for local Neo4j Community instance
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=threatlens_password
NEO4J_DATABASE=neo4j

# Connection pool & timeout tuning
NEO4J_CONNECTION_TIMEOUT_SECONDS=5.0
NEO4J_MAX_CONNECTION_LIFETIME_SECONDS=3600.0
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# =====================================================================
# ThreatLens GraphOps - Apache Kafka Event Streaming Configuration
# =====================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=threatlens-graphops
KAFKA_CONSUMER_GROUP=threatlens-graphops-workers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_POLL_TIMEOUT_SECONDS=1.0
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_SECONDS=0.5
KAFKA_DLQ_ENABLED=true

# Topic definitions
KAFKA_TOPIC_ENDPOINT_EVENTS=security.endpoint.events
KAFKA_TOPIC_IDENTITY_EVENTS=security.identity.events
KAFKA_TOPIC_NETWORK_EVENTS=security.network.events
KAFKA_TOPIC_EMAIL_EVENTS=security.email.events
KAFKA_TOPIC_FINDINGS=graphops.findings
KAFKA_TOPIC_DLQ=graphops.events.dlq

# =====================================================================
# ThreatLens Security & Governance Configuration
# =====================================================================
# Administrative API Key for schema/ingest and policy mutation operations
ADMIN_API_KEY=your_admin_api_key_here
REQUIRE_API_KEY=false
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# =====================================================================
# ThreatLens GraphOps - scikit-learn Anomaly Detection Configuration
# =====================================================================
SKLEARN_MODEL_PATH=backend/data/models/event_isolation_forest.joblib
SKLEARN_META_PATH=backend/data/models/event_isolation_forest_meta.json
SKLEARN_CONTAMINATION=0.08
SKLEARN_RANDOM_SEED=42
SKLEARN_ANOMALY_THRESHOLD=0.0

# =====================================================================
# ThreatLens GraphOps - PyTorch Geometric (PyG) Graph Learning Configuration
# =====================================================================
PYG_MODEL_PATH=backend/data/models/pyg_structural_gnn.pt
PYG_META_PATH=backend/data/models/pyg_structural_gnn_meta.json
PYG_EMBEDDING_DIM=64
PYG_HIDDEN_DIM=64
PYG_ANOMALY_THRESHOLD=60.0
PYG_LEARNING_RATE=0.01
PYG_NUM_EPOCHS=100
PYG_DEVICE=cpu
PYG_MAX_SUBGRAPH_HOPS=2
PYG_MAX_SUBGRAPH_NODES=200

# =====================================================================
# ThreatLens Remote Windows Collector Configuration
# =====================================================================
# HMAC signing secret for collector token digests.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be changed from default in production deployments.
COLLECTOR_REGISTRY_SECRET=threatlens_dev_collector_secret_change_in_prod

# Path to the JSON file storing enrolled collector records.
# Ensure this file is NOT committed to source control (.gitignore covers backend/data/).
COLLECTOR_REGISTRY_PATH=backend/data/collector_registry.json

# Maximum Windows events per POST /collector/ingest/events request (hard cap: 500)
COLLECTOR_MAX_EVENTS_PER_BATCH=500

# Maximum request body size for collector ingestion endpoints (bytes, default: 4 MB)
COLLECTOR_MAX_REQUEST_SIZE_BYTES=4194304

# Sliding-window rate limit: maximum requests per minute per collector
COLLECTOR_RATE_LIMIT_RPM=60


